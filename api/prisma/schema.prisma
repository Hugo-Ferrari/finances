// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma/client.ts"
  moduleFormat = "cjs"
}


datasource db {
  provider = "postgresql"
}

model Usuario  {
  id          Int    @id   @default(autoincrement())
   nome       String
  email       String  @unique
  senha       String  
  conta       Conta[] 
  categoria   Categoria[]
  orcamento   Orcamento[]
  caixinhas   Caixinha[]
  recorrentes Recorrente[]

  // Planejamento: % da renda que a pessoa quer guardar (usado no "pode gastar hoje")
  metaEconomia Decimal @default(20)
}


model Conta{
  id              Int     @id       @default(autoincrement())  //autoincrement de uma chave primaria
  nome            String  
  tipo       Tipo @default(CORRENTE) //uso de unum com valor padrão
  saldo       Decimal  @default(0)
  ativa           Boolean @default(true)
  usuarioId       Int // guardando chave estrangeira que guarda o id do usuario
  usuario         Usuario     @relation(fields: [usuarioId], references: [id], onDelete: Cascade) 
  transacao       Transacao[]
  movimentosCaixinha MovimentoCaixinha[]
  recorrentes     Recorrente[]
}

model Categoria{
  id           Int     @id     @default(autoincrement())
  nome         String  
  usuarioId    Int 
  usuario      Usuario      @relation(fields:[usuarioId],references:[id], onDelete:Cascade)    
  transacao   Transacao[]
  orcamento   Orcamento[]
  recorrentes Recorrente[]

   @@unique([usuarioId, nome]) // um usuario nn pode ter categorias com o mesmo nome 
}

model Transacao {
  id            Int           @id @default(autoincrement())
  tipoTransacao TipoTransacao @default(ENTRADA)
  valor         Decimal
  descricao     String?
  data          DateTime      @default(now())
  contaId       Int
  conta         Conta         @relation(fields: [contaId], references: [id])
  categoriaId   Int?
  categoria     Categoria?    @relation(fields: [categoriaId], references: [id], onDelete: SetNull)
  ocorrenciaRecorrente OcorrenciaRecorrente?
}
model Orcamento {
  id          Int      @id @default(autoincrement())
  valor       Decimal
  usuarioId   Int
  categoriaId Int

  usuario     Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  categoria   Categoria @relation(fields: [categoriaId], references: [id], onDelete: Cascade)

  @@unique([usuarioId, categoriaId])
}



enum Tipo{
    CORRENTE 
    POUPANCA
    CARTEIRA
}

enum TipoTransacao{
  ENTRADA
  SAIDA
}


// ── Caixinhas: dinheiro guardado que rende, separado das contas do dia a dia ──

model Caixinha {
  id          Int      @id @default(autoincrement())
  nome        String
  instituicao String?
  isentaIR    Boolean  @default(false)
  criadaEm    DateTime @default(now())
  usuarioId   Int
  usuario     Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  taxas       TaxaCaixinha[]
  movimentos  MovimentoCaixinha[]
}

// Histórico de taxas: cada taxa vale a partir de `inicio` (não refaz o passado).
model TaxaCaixinha {
  id         Int         @id @default(autoincrement())
  taxa       Decimal     // em %, ex.: 1 = 1%
  periodo    PeriodoTaxa
  inicio     DateTime    // dia (meia-noite UTC), mesma convenção das transações
  caixinhaId Int
  caixinha   Caixinha    @relation(fields: [caixinhaId], references: [id], onDelete: Cascade)
}

model MovimentoCaixinha {
  id         Int                   @id @default(autoincrement())
  tipo       TipoMovimentoCaixinha
  // DEPOSITO/RETIRADA: valor movimentado; AJUSTE: saldo informado pelo banco
  valor      Decimal
  data       DateTime
  criadoEm   DateTime              @default(now())
  caixinhaId Int
  caixinha   Caixinha              @relation(fields: [caixinhaId], references: [id], onDelete: Cascade)
  // Conta de onde saiu (depósito) ou para onde foi (retirada) o dinheiro
  contaId    Int?
  conta      Conta?                @relation(fields: [contaId], references: [id], onDelete: SetNull)
}

enum PeriodoTaxa {
  MENSAL
  ANUAL
}

enum TipoMovimentoCaixinha {
  DEPOSITO
  RETIRADA
  AJUSTE
}


// ── Planejamento: contas fixas, salário e compras parceladas ──

// Lançamento que se repete todo mês no mesmo dia (salário, aluguel, assinatura)
// ou compra parcelada (parcelasTotal preenchido). Nada é lançado sozinho: cada
// mês a pessoa confirma ("Marcar como paga") e aí vira uma Transacao.
model Recorrente {
  id             Int           @id @default(autoincrement())
  descricao      String
  valor          Decimal       // valor de cada mês / de cada parcela
  tipoTransacao  TipoTransacao @default(SAIDA)
  // Primeira ocorrência (meia-noite UTC). O dia dela é o dia de todo mês;
  // em meses mais curtos vale o último dia (31 → 30/11, 28/02).
  inicio         DateTime
  // Compra parcelada: total de parcelas e número da parcela da 1ª ocorrência
  // (compra antiga já com 3 pagas → parcelaInicial = 4).
  parcelasTotal  Int?
  parcelaInicial Int           @default(1)
  valorAVista    Decimal?      // preço à vista, para mostrar os juros
  ehSalario      Boolean       @default(false)
  ativo          Boolean       @default(true)
  criadoEm       DateTime      @default(now())
  usuarioId      Int
  usuario        Usuario       @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  contaId        Int?
  conta          Conta?        @relation(fields: [contaId], references: [id], onDelete: SetNull)
  categoriaId    Int?
  categoria      Categoria?    @relation(fields: [categoriaId], references: [id], onDelete: SetNull)
  ocorrencias    OcorrenciaRecorrente[]

  @@index([usuarioId])
}

// O que aconteceu com um mês de um Recorrente: pago (com a transação criada)
// ou pulado (transacaoId nulo). Mês sem linha = pendente.
model OcorrenciaRecorrente {
  id           Int        @id @default(autoincrement())
  competencia  String     // AAAA-MM
  criadaEm     DateTime   @default(now())
  recorrenteId Int
  recorrente   Recorrente @relation(fields: [recorrenteId], references: [id], onDelete: Cascade)
  // Apagar a transação devolve o mês para "pendente".
  transacaoId  Int?       @unique
  transacao    Transacao? @relation(fields: [transacaoId], references: [id], onDelete: Cascade)

  @@unique([recorrenteId, competencia])
}
