{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "api": {
      "root": "api",
      "framework": "nestjs"
    },
    "web": {
      "root": "web",
      "framework": "nextjs"
    }
  },
  "rewrites": [
    {
      "source": "/auth/(.*)",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/conta",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/conta/(.*)",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/categoria",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/categoria/(.*)",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/transacao",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/transacao/(.*)",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/orcamento",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/orcamento/(.*)",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/ia/comprovante",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/api",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/api-json",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/usuario",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/usuario/(.*)",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "web"
      }
    }
  ]
}